# Gemini AI — required for food text/photo/barcode analysis + supplement AI
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude) — primary provider for the AI health summary.
# If set, the summary route uses Claude (best reasoning); Gemini is the automatic
# fallback if this key is missing or the Claude call fails. Optional.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Override the Claude model used for the summary + correlation narration
# (default: claude-sonnet-5-5 — ~25s on real data; claude-opus-5-5 is richer but ~75s
# at standard speed, which runs past the Azure gateway cut unless fast mode is enabled).
# ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5-5
# TOTAL time budget for the AI summary call (ms, default 70000) — the Claude attempt
# and the Gemini fallback share one deadline (Claude gets the budget minus ~22s
# reserved for one Gemini attempt). The summary route streams heartbeat bytes while
# generating, which keeps Azure SWA's ~45s idle-kill gateway from cutting the request,
# so this budget is about user patience rather than the gateway.
ANTHROPIC_SUMMARY_TIMEOUT_MS=70000
# Thinking effort for the summary (low/medium/high, default medium). "high" makes the
# model think substantially longer — on the production gateway budget it often causes
# the Claude attempt to hit its deadline and fall back to Gemini. Leave unset in prod.
# ANTHROPIC_SUMMARY_EFFORT=medium
# Fast mode (research preview) — runs the summary on Opus at up to 2.5× output speed,
# at premium token pricing. On by default when the summary model is Opus 5.5/5/4.8
# (ignored for other models); a fast-mode rate limit retries once at standard speed.
# Needs fast mode enabled on the Anthropic account — with a limit of 0 every attempt
# 429s and runs at standard speed.
# Set to 0 to disable and always run at standard speed/pricing.
ANTHROPIC_SUMMARY_FAST=1
# Model for the health-data chat (default: claude-opus-5-5).
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# Model for the grounded supplement-label lookup (default: claude-opus-5-5). This one
# uses the web_search server tool to read a product's Supplement Facts panel off the
# manufacturer's page — without ANTHROPIC_API_KEY the lookup is skipped entirely and
# blends stay "ingredients NOT RECORDED" rather than being guessed.
# ANTHROPIC_INGREDIENTS_MODEL=claude-opus-5-5

# Azure Blob Storage — NOTE: setting this locally points `npm run dev` at PRODUCTION
# data. Leave it empty for a sandboxed local run against data/*.json. — required when deployed to Azure Static Web Apps
# Leave empty to use local filesystem (default for local dev)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=henadzittracker
